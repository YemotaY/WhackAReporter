# Copy to `.env` (git-ignored) and fill in. Nothing here is secret except what
# is explicitly marked; real secrets go into secrets/ (also git-ignored).

# Release version stamped onto artefact names / export folder.
VERSION=1.0.0

# itch.io target "<user>/<game>" for `make itch`.
ITCH_TARGET=yemotay/whack-a-reporter

# Android signing (files live in secrets/, created by `make setup-android`).
ANDROID_KEY_ALIAS=whackareporter

# Optional: override the Godot editor binary used for exporting.
# GODOT_BIN=godot

# Optional: parallel build jobs for compiling export templates.
# JOBS=16
